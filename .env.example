# FastAPI
CREDIT_PASSPORT_DB_PATH=./data/credit_passport.db
CREDIT_PASSPORT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CREDIT_PASSPORT_MAX_UPLOAD_BYTES=10485760
CREDIT_PASSPORT_MODEL_METRICS_PATH=../model_pipeline/artifacts/icp_metrics.json
CREDIT_PASSPORT_CHALLENGER_MODEL_ARTIFACT_PATH=../model_pipeline/artifacts/icp_challenger.joblib

# Optional transition guide provider. Copy this file to the repository root as
# .env (or to backend/.env). Both local files are ignored; never commit a key.
# Leave GEMINI_API_KEY blank for the deterministic, source-grounded guide.
CREDIT_PASSPORT_GUIDE_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT_SECONDS=20

# Browser client
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
